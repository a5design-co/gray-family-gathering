---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import EventDetails from '../components/EventDetails.astro';
import Schedule from '../components/Schedule.astro';
import Hotel from '../components/Hotel.astro';
import Activities from '../components/Activities.astro';
import Menu from '../components/Menu.astro';
import RSVP from '../components/RSVP.astro';
import Footer from '../components/Footer.astro';

// Google Apps Script RSVP endpoint. Hardcoded (not secret — it's already
// embedded in the public client HTML) so every build has it, even when the
// host rebuilds from git without the gitignored .env present.
const GOOGLE_SCRIPT_URL =
	'https://script.google.com/macros/s/AKfycbz5hndsSj-jHw-3JPtf83GBxXEcOrh4-cOrC4iCEZfeW3XK1q3jcMr8ygyrlK-GmuA0/exec';
---

<Layout title="Gray Family Gathering 2026">
	<Navbar />
	<main>
		<Hero />
		<About />
		<EventDetails />
		<Schedule />
		<Hotel />
		<Activities />
		<Menu />
		<RSVP googleScriptUrl={GOOGLE_SCRIPT_URL} />
	</main>
	<Footer />
</Layout>
