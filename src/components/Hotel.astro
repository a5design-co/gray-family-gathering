---
interface Room {
  type:  string;
  price: string;
}

interface Hotel {
  name:          string;
  address:       string;
  dates:         string;
  groupName:     string;
  groupCode:     string;
  phone:         string;
  deadline:      string;
  rooms:         Room[];
  perks:         string[];
  standardRate?: string;
  roomsLeft?:    number;
  notes?:        string[];
}

const hotels: Hotel[] = [
  {
    name:         'Hampton Inn — Orland Park',
    address:      '16176 S La Grange Rd, Orland Park, IL 60467',
    dates:        'July 8 – 11, 2026',
    groupName:    "Gray's Thanksgiving in July",
    groupCode:    '601',
    phone:        '1-888-446-6677',
    deadline:     'June 15, 2026',
    standardRate: '$400/night',
    roomsLeft:    10,
    rooms: [
      { type: 'King Room', price: '$193/night' },
      { type: '2 Queens',  price: '$185/night' },
    ],
    perks: ['Free Breakfast', 'Free Parking'],
  },
  {
    name:      'Hilton Chicago/Oak Lawn',
    address:   '9333 S Cicero Ave, Oak Lawn, IL 60453',
    dates:     'July 8 – 11, 2026',
    groupName: "Gray's Thanksgiving in July",
    groupCode: '605',
    phone:     '(708) 425-7800',
    deadline:  'June 14, 2026',
    rooms: [
      { type: '1 King',   price: '$171.20/night' },
      { type: '2 Queens',  price: '$176.53/night' },
    ],
    perks: [],
    notes: [
      '13 minutes from Midway Airport',
      '20 minutes from the house',
    ],
  },
];
---

<style>
    .hotel-card {
        box-shadow: rgba(0, 0, 0, 0.4) 0px 2px 4px, rgba(0, 0, 0, 0.3) 0px 7px 13px -3px, rgba(0, 0, 0, 0.2) 0px -3px 0px inset;
    }
</style>

<section class="py-32 px-6 bg-white relative" id="hotel">
    <!-- Decorative abstract background element -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden text-primary/5 text-center">
        <span class="material-symbols-outlined text-[300px] leading-none mt-20 inline-block rotate-6">hotel</span>
    </div>

    <div class="max-w-4xl mx-auto relative z-10">
        <div class="text-center mb-16">
            <p class="text-xs uppercase tracking-[0.4em] text-primary/60 mb-2 font-bold">Where to Stay</p>
            <h2 class="text-6xl font-serif italic text-earth-taupe mb-6">Hotel Information</h2>
            <div class="w-16 h-1 bg-primary mx-auto"></div>
        </div>

        <div class="flex flex-col gap-12">
            {hotels.map((hotel) => {
                const hasBreakfast = hotel.perks.some((p) => p.toLowerCase().includes('breakfast'));
                const hasParking = hotel.perks.some((p) => p.toLowerCase().includes('parking'));
                const otherPerks = hotel.perks.filter(
                    (p) => !p.toLowerCase().includes('parking') && !p.toLowerCase().includes('breakfast'),
                );

                return (
                    <div class="hotel-card bg-white p-8 md:p-12 rounded-2xl relative overflow-hidden">
                        <!-- Background Icon inside card -->
                        <span class="material-symbols-outlined absolute top-8 right-8 text-8xl text-primary/10 pointer-events-none">domain</span>

                        <h3 class="text-2xl font-serif text-earth-taupe mb-2">{hotel.name}</h3>
                        <p class="text-earth-taupe/60 mb-8 border-b border-earth-taupe/10 pb-6">{hotel.address}</p>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
                            <div class="flex flex-col gap-1">
                                <span class="text-[0.7rem] uppercase tracking-[0.2em] font-bold text-primary">Reservation Dates</span>
                                <span class="text-earth-taupe font-medium">{hotel.dates}</span>
                            </div>
                            <div class="flex flex-col gap-1">
                                <span class="text-[0.7rem] uppercase tracking-[0.2em] font-bold text-primary">Group Name</span>
                                <span class="text-earth-taupe font-medium">{hotel.groupName}</span>
                            </div>
                            <div class="flex flex-col gap-1">
                                <span class="text-[0.7rem] uppercase tracking-[0.2em] font-bold text-primary">{hotel.groupCode.length <= 3 ? 'Group Code' : 'SRP Code'}</span>
                                <span class="text-earth-taupe font-bold text-lg">{hotel.groupCode}</span>
                            </div>
                            <div class="flex flex-col gap-1">
                                <span class="text-[0.7rem] uppercase tracking-[0.2em] font-bold text-primary">To Book (call for discount)</span>
                                <a class="text-earth-taupe font-bold hover:text-primary transition-colors hover:underline" href={`tel:${hotel.phone.replace(/[^0-9]/g, '')}`}>{hotel.phone}</a>
                            </div>
                            <div class="flex flex-col gap-1">
                                <span class="text-[0.7rem] uppercase tracking-[0.2em] font-bold text-primary">Booking Deadline</span>
                                <span class="text-earth-taupe font-medium">{hotel.deadline}</span>
                            </div>
                        </div>

                        <div class="flex flex-wrap gap-4 mb-8">
                            {hotel.rooms.map(r => (
                                <div class="bg-earth-cream border border-earth-taupe/10 px-6 py-4 rounded-xl text-center min-w-[140px]">
                                    <span class="block text-sm text-earth-taupe/70 uppercase tracking-widest font-bold mb-1">{r.type}</span>
                                    <strong class="block text-2xl text-primary font-serif">{r.price}</strong>
                                </div>
                            ))}
                        </div>

                        {/* Limited availability & standard rate warning */}
                        {hotel.roomsLeft && hotel.standardRate && (
                            <div class="flex items-start gap-4 bg-red-50 border-2 border-red-300 rounded-xl px-6 py-5 mb-8 shadow-[0_0_0_3px_rgba(239,68,68,0.1)]">
                                <span class="material-symbols-outlined text-3xl text-red-600 mt-0.5 shrink-0">warning</span>
                                <div>
                                    <p class="text-sm font-bold uppercase tracking-widest text-red-700 mb-1">Only {hotel.roomsLeft} Discounted Rooms Left!</p>
                                    <p class="text-earth-taupe/90 text-sm leading-relaxed">Due to a major sports event, standard hotel rates are <strong class="text-red-600">{hotel.standardRate}</strong>. Our group block has significantly lower rates — but only {hotel.roomsLeft} rooms remain. Call now to secure yours!</p>
                                </div>
                            </div>
                        )}

                        {/* Location / travel notes */}
                        {hotel.notes && hotel.notes.length > 0 && (
                            <div class="flex items-start gap-4 bg-blue-50 border-2 border-blue-200 rounded-xl px-6 py-5 mb-8">
                                <span class="material-symbols-outlined text-3xl text-blue-600 mt-0.5 shrink-0">directions_car</span>
                                <div>
                                    <p class="text-sm font-bold uppercase tracking-widest text-blue-700 mb-1">Location Details</p>
                                    <ul class="text-earth-taupe/90 text-sm leading-relaxed list-none space-y-1">
                                        {hotel.notes.map(n => <li>{n}</li>)}
                                    </ul>
                                </div>
                            </div>
                        )}

                        {/* Breakfast callout */}
                        {hasBreakfast && (
                            <div class="flex items-start gap-4 bg-[#fff8e8] border-2 border-[#e8c84a]/70 rounded-xl px-6 py-5 mb-6 shadow-[0_0_0_3px_rgba(232,200,74,0.15)]">
                                <span class="material-symbols-outlined text-3xl text-[#8a6a1f] mt-0.5 shrink-0">free_breakfast</span>
                                <div>
                                    <p class="text-sm font-bold uppercase tracking-widest text-[#8a6a1f] mb-1">Free Hot Breakfast Daily</p>
                                    <p class="text-earth-taupe/90 text-sm leading-relaxed">Start each morning with complimentary breakfast before heading out for family activities.</p>
                                </div>
                            </div>
                        )}

                        {/* Other perks */}
                        {otherPerks.length > 0 && (
                            <div class="flex flex-wrap gap-4 mb-6">
                                {otherPerks.map(p => (
                                    <span class="flex items-center gap-2 text-sm text-earth-taupe/80 font-medium bg-primary/5 px-4 py-2 rounded-full">
                                        <span class="material-symbols-outlined text-[16px] text-primary">check_circle</span>
                                        {p}
                                    </span>
                                ))}
                            </div>
                        )}

                        {/* Parking callout */}
                        {hasParking && (
                            <div class="flex items-start gap-4 bg-primary/10 border border-primary/30 rounded-xl px-6 py-5 mb-10">
                                <span class="material-symbols-outlined text-3xl text-primary mt-0.5 shrink-0">local_parking</span>
                                <div>
                                    <p class="text-sm font-bold uppercase tracking-widest text-primary mb-1">Free Parking Included</p>
                                    <p class="text-earth-taupe/80 text-sm leading-relaxed">Complimentary on-site parking for all hotel guests — no extra charge for the duration of your stay.</p>
                                </div>
                            </div>
                        )}

                        <div class="inline-block bg-[#fdf2e9] text-[#e67e22] px-6 py-3 rounded-lg text-sm font-bold uppercase tracking-widest border border-[#f5c6cb]">
                            ⚠️ Book by {hotel.deadline} to get the group rate
                        </div>
                    </div>
                );
            })}
        </div>
    </div>
</section>
